.DS_Store
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
tmp/
data/private/**
!data/private/.gitkeep

# Rolling export destination: regenerated by every `ibi export`, so tracking it
# would put a ~20 MB diff in front of every unrelated change. Dated snapshots
# under data/exports/<date>/ are kept.
data/exports/latest/

# The dedupe work queue is a generated 34k-row intermediate, not an aggregate
# result. It is reproducible from the database with `ibi dedupe` and would add
# ~100 MB to history across the dated snapshots.
data/exports/**/dedupe_candidates.*
data/exports/**/dedupe_evidence.*

# Dated research snapshots stay local. They are full-corpus dumps whose free-text
# fields, catalogue descriptions and media URLs have had no release review — the
# export manifest says so. The reviewed, gated projection lives in data/public/.
data/exports/*/
